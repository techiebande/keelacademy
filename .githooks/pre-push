#!/usr/bin/env bash
# keelacademy content gate (S2.1) — runs on every push.
#
# Blocks the push when content fails schema validation; the validator output
# names the offending file(s). CI (.github/workflows/content-gate.yml) runs
# the same two commands on content PRs.
#
# One-time activation (per clone — a human setup act, not under test):
#   git config core.hooksPath .githooks
#
# Bypass for scripted tooling (loud by design):
#   KEEL_SKIP_CONTENT_GATE=1 git push
set -u
cd "$(git rev-parse --show-toplevel)"

if [ "${KEEL_SKIP_CONTENT_GATE:-0}" = "1" ]; then
    echo "[keel-content-gate] SKIPPED via KEEL_SKIP_CONTENT_GATE=1 — content schemas NOT validated on this push" >&2
    exit 0
fi

PY="$(command -v python3 || command -v python)"
if [ -z "$PY" ]; then
    echo "[keel-content-gate] BLOCKED: no python interpreter found — cannot validate content" >&2
    exit 1
fi

fail=0
echo "[keel-content-gate] validating content (schemas, rubrics, gates, map, routing, lesson code)..."
if ! "$PY" content/tools/validate.py; then
    echo "[keel-content-gate] BLOCKED: content/tools/validate.py failed — offending file(s) named in the FAIL lines above" >&2
    fail=1
fi
if ! "$PY" content/tools/validate-rubrics.py; then
    echo "[keel-content-gate] BLOCKED: content/tools/validate-rubrics.py failed — offending file(s) named in the FAIL lines above" >&2
    fail=1
fi
if ! "$PY" content/tools/validate-gates.py; then
    echo "[keel-content-gate] BLOCKED: content/tools/validate-gates.py failed — offending file(s) named in the FAIL lines above" >&2
    fail=1
fi
if ! "$PY" content/tools/validate-map.py; then
    echo "[keel-content-gate] BLOCKED: content/tools/validate-map.py failed — offending file(s) named in the FAIL lines above" >&2
    fail=1
fi
if ! "$PY" content/tools/validate-routing.py; then
    echo "[keel-content-gate] BLOCKED: content/tools/validate-routing.py failed — offending file(s) named in the FAIL lines above" >&2
    fail=1
fi
if ! "$PY" content/tools/validate-guard-evals.py; then
    echo "[keel-content-gate] BLOCKED: content/tools/validate-guard-evals.py failed — offending file(s) named in the FAIL lines above" >&2
    fail=1
fi
if ! "$PY" content/tools/validate-diagnostics.py; then
    echo "[keel-content-gate] BLOCKED: content/tools/validate-diagnostics.py failed — offending file(s) named in the FAIL lines above" >&2
    fail=1
fi

# Student-facing boundary: lessons never expose private repository paths.
if ! "$PY" content/tools/validate-student-facing.py; then
    echo "[keel-content-gate] BLOCKED: student-facing prose references private source files or repository paths" >&2
    fail=1
fi

# The one lesson gate: every code block on a page does what the page says.
# (docs/lesson-design.md section 3; no shape rules, no readability score.)
lesson_files="$(find content/units -type f -name 'lesson*.md' 2>/dev/null)"
if [ -n "$lesson_files" ]; then
    if ! "$PY" content/tools/run-lesson-code.py --all; then
        echo "[keel-content-gate] BLOCKED: run-lesson-code.py found a code block whose output differs from the page" >&2
        fail=1
    fi
else
    echo "[keel-content-gate] note: no lesson files; code check skipped"
fi

if ! "$PY" platform/grading/scripts/check-concierge-structural.py; then
    echo "[keel-content-gate] BLOCKED: platform/grading/scripts/check-concierge-structural.py failed — offending file(s) named in the FAIL lines above" >&2
    fail=1
fi
if [ $fail = 0 ]; then
    echo "[keel-content-gate] OK — content validates, push allowed."
fi
exit $fail
