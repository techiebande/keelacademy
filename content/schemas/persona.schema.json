{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keelacademy.dev/schemas/persona.schema.json",
  "title": "Persona",
  "description": "A simulation persona for the Phase 11 simulation engine (prospects, skeptical reviewers).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "role", "grounding", "rubric_ref", "scoring"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "role": {
      "type": "string",
      "enum": ["prospect", "reviewer", "other"],
      "description": "Which simulation slot this persona fills (school-architecture §6)"
    },
    "grounding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["refs"],
      "properties": {
        "refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Curriculum/docs paths the persona's behavior is grounded in"
        }
      }
    },
    "rubric_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Path to the rubric scoring transcripts against this persona"
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass_rule", "criteria"],
      "properties": {
        "pass_rule": {
          "enum": ["all", "weighted"]
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "weight"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Used when pass_rule is weighted; ignored for all"
              }
            }
          }
        }
      }
    }
  }
}
