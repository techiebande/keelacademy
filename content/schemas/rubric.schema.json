{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keelacademy.dev/schemas/rubric.schema.json",
  "title": "Rubric",
  "description": "Layer-2 judge rubric for a unit's build deliverable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "pass_rule", "judge", "golden_set", "criteria"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^rubric-[0-9]+\\.[0-9]+(\\.[0-9]+)?$",
      "description": "e.g. rubric-0.1 or rubric-3.2.1"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "pass_rule": {
      "enum": ["all", "weighted"]
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "model_tier"],
      "properties": {
        "prompt": { "type": "string", "minLength": 1 },
        "model_tier": {
          "type": "string",
          "enum": ["low", "mid", "high"]
        }
      }
    },
    "golden_set": {
      "type": "string",
      "minLength": 1,
      "description": "Path to private, rotated set of 15-30 pre-graded submissions"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "description": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
