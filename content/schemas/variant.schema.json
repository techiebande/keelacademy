{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keelacademy.dev/schemas/variant.schema.json",
  "title": "Data variant",
  "description": "A per-student synthetic data corpus definition: generator + parameter ranges + seed rule.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "generator", "parameters", "seed_rule"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*@v[0-9]+$",
      "description": "e.g. omnicart@v3"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script"],
      "properties": {
        "script": {
          "type": "string",
          "minLength": 1,
          "description": "Path to the generator script"
        }
      }
    },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "range"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "range": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["min", "max"],
                "properties": {
                  "min": { "type": "number" },
                  "max": { "type": "number" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["values"],
                "properties": {
                  "values": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": ["string", "number", "boolean"] }
                  }
                }
              }
            ]
          },
          "description": {
            "type": "string",
            "description": "Optional human note on what the parameter varies"
          }
        }
      }
    },
    "seed_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["per_student"],
      "properties": {
        "per_student": {
          "type": "string",
          "const": "hash(student_id, unit_id)",
          "description": "Fixed seed derivation: every student's corpus differs but is reproducible"
        }
      }
    }
  }
}
