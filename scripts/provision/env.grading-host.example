# /etc/keelacademy/env — grading-host secrets and knobs.
# Template only: every CHANGE_ME must be filled before 30-services.sh runs.
# chmod 600, owner root. Never commit the filled file. Source of truth for the
# real values: platform/FOUNDER-WIRING.md (Clerk/Stripe wiring lives THERE,
# app-side values go to Vercel, not here).

# --- Database (read by every service via KEEL_DB_CMD) ---
# The value is quoted so bash provisioning scripts can source this file safely;
# systemd EnvironmentFile strips the quotes.
KEEL_DB_CMD="docker exec -i keel-pg psql -U keel -d grading"
POSTGRES_USER=keel
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=grading

# --- Ports (all bind 127.0.0.1; Caddy terminates TLS in front) ---
KEEL_INTAKE_PORT=8787
KEEL_READER_PORT=8790
KEEL_ENROLL_PORT=8791
KEEL_PRACTICE_PORT=8792
KEEL_PROXY_PORT=8794

# --- Public hostname Caddy answers for (40-caddy.sh) ---
KEEL_HOSTNAME=grading.example.com

# --- LLM (only the proxy holds the real key; it forwards for everyone) ---
OPENAI_API_KEY=CHANGE_ME
KEEL_PROXY_UPSTREAM_URL=https://api.openai.com/v1
KEEL_PROXY_TIMEOUT_S=120
# Per-unit token cap across all students (M5.4); unset or 0 disables
KEEL_UNIT_TOKENS_CAP=2000000
# Every LLM call appends one JSON line here; give it disk and prune it
KEEL_TRACE_LOG=/var/log/keelacademy/traces.jsonl

# --- Grading worker (routes the judge through the local proxy) ---
KEEL_LLM_BASE_URL=http://127.0.0.1:8794/v1
KEEL_PROXY_URL=http://127.0.0.1:8794
KEEL_SANDBOX_IMAGE=keel-runner:0.1
KEEL_SANDBOX_TIMEOUT_S=120
KEEL_STALE_AFTER_S=300
KEEL_POLL_INTERVAL_S=0.5

# --- Enroll service + Stripe (test mode first: sk_test_...) ---
KEEL_ENROLL_SECRET=CHANGE_ME_LONG_RANDOM_SHARED_WITH_VERCEL
STRIPE_SECRET_KEY=CHANGE_ME_sk_test
KEEL_STRIPE_API_URL=https://api.stripe.com/v1
KEEL_STRIPE_WEBHOOK_SECRET=CHANGE_ME_whsec
KEEL_PRICE_CENTS_DEFAULT=4900
KEEL_DEFAULT_BUDGET_TOKENS=100000
KEEL_STRIPE_TOLERANCE_S=300

# --- Intake (GitHub push webhooks; needed only when code units go live) ---
KEEL_WEBHOOK_SECRET=CHANGE_ME_LONG_RANDOM

# --- Rebate machine (FOUNDER-WIRING.md: payout itself stays a manual step) ---
KEEL_REBATE_PCT=15
KEEL_REBATE_GATES=phase-5-integration,capstone
KEEL_REBATE_WINDOW_DAYS=365
KEEL_REBATE_POLL_S=2

# --- S2.6 all-access subscription (Paddle Billing) ---
# KEEL_BILLING_PROVIDER selects the enrollment surface: paddle (sandbox/live),
# stripe (S2.5 per-unit legacy), fake (offline deterministic proof).
KEEL_BILLING_PROVIDER=fake
# Real Paddle (sandbox shown; live keys are pdl_live_...):
#PADDLE_API_KEY=pdl_sdbx_apikey_CHANGE_ME
#PADDLE_PRICE_ID=pri_01hCHANGE_ME
#KEEL_PADDLE_API_URL=https://sandbox-api.paddle.com
#KEEL_PADDLE_WEBHOOK_SECRET=pdl_ntfset_CHANGE_ME
#KEEL_PADDLE_TOLERANCE_S=300
